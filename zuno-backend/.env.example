# Copy this file to `.env` and fill in your real values.
# NEVER commit the real .env file to git.

FLASK_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_this_with_a_long_random_value

# MySQL / XAMPP connection details
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zuno_waitlist

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# The frontend's own base URL. After someone clicks the verification
# link in their email, the API redirects the browser here, to
# /waitlist/confirm (see zuno-website: src/routes/waitlist.confirm.tsx).
FRONTEND_URL=http://localhost:3000

# Optional: point this at Redis in production for multi-server rate limiting.
# RATELIMIT_STORAGE_URI=redis://localhost:6379

# Shared secret for the admin dashboard. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The frontend's own server (src/lib/admin-backend.server.ts in
# zuno-website) sends this as the X-Admin-Key header on every admin
# request — the browser itself never sees this value. Must match
# ADMIN_API_KEY in the frontend's server-side env exactly.
ADMIN_API_KEY=replace_this_with_a_long_random_value
