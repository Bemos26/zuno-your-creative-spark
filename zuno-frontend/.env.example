# Base URL of the Flask waitlist API (no trailing slash).
# Local dev example:
VITE_API_BASE_URL=http://localhost:5000

# Deployed example:
# VITE_API_BASE_URL=https://api.zuno.app

# ---------------------------------------------------------------------------
# Server-only vars below. Do NOT prefix these with VITE_ — VITE_* vars are
# bundled into the client JS bundle and become world-readable. These are
# only read inside src/routes/api.admin.*.ts server handlers, which
# TanStack Start compiles as server-only code, so they never reach the
# browser. Set these in your deploy platform's secret/env store, not in a
# committed file.
# ---------------------------------------------------------------------------

# Where the backend lives, for server-to-server calls made by
# src/lib/admin-backend.server.ts (not sent to the browser).
WAITLIST_API_URL=http://localhost:5000

# Must match ADMIN_API_KEY in the backend's .env exactly. Also reused as the
# HMAC secret that signs the admin session cookie — see
# src/lib/admin-session.server.ts.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=replace_this_with_the_backends_ADMIN_API_KEY

# The password typed into the /admin/waitlist login screen. Pick your own —
# it does not need to match anything on the backend.
ADMIN_DASHBOARD_PASSWORD=replace_this_with_a_strong_password
